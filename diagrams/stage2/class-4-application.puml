@startuml class-4-application
!include style.iuml
title 3.5 Presentation and application layers (as implemented)

package "avsa.presentation" {
  class MainWindow {
    + start(stage : Stage) : void
    + onEvent(event : AgentEvent) : void
    - showBusy(message : String, stop : Runnable) : void
    - refreshAll() : void
  }
  class AvsaCli {
    ~ run(args : String[]) : int
    + main(args : String[]) : void
    + onEvent(event : AgentEvent) : void
    ~ {static} dataDir() : Path
  }
  class CliOptions {
    ~ word(i : int) : String
    ~ option(name : String) : Optional<String>
    ~ flag(name : String) : boolean
  }
  class CurrentSessionFile {
    ~ restore(sessions : SessionService) : void
    ~ remember(sessions : SessionService) : void
  }
  class GuiContext {
    ~ run(message : String, work : Callable<T>, onSuccess : Consumer<T>) : void
    ~ run(message : String, work : Callable<T>, onSuccess : Consumer<T>, stop : Runnable) : void
    ~ controller() : AgentController
    ~ session() : Optional<Session>
    ~ confirm(question : String) : boolean
    ~ problem(e : Exception) : void
  }
  abstract class FeatureTab {
    # ctx : GuiContext
    ~ {abstract} title() : String
    ~ {abstract} content() : Node
    ~ {abstract} refresh() : void
  }
  class VehicleTab
  class HistoryTab
  class MarketTab
  class PricingTab
  class PositioningTab
  class ForecastTab
  class ListingTab
  class ExportTab
  class OffersTab
  class SimulatorTab
  class SessionsTab
  class AssistantPanel
}

package "avsa.application" {

  class AvsaApplication {
    + {static} create(config : AppConfig, dataDir : Path, clock : Clock, llm : LLMClient) : AgentController
  }

  class AgentController <<Facade>> {
    + saveProfile(profile : VehicleProfile) : VehicleProfile
    + findComparables(request : SearchRequest, source : MarketSourceType, csv : Path) : MarketSnapshot
    + excludeComparable(listingId : String, excluded : boolean) : MarketSnapshot
    + pinComparable(listingId : String, pinned : boolean) : MarketSnapshot
    + importHistory(input : HistoryInput) : HistoryImportResult
    + confirmHistory(history : VehicleHistory) : void
    + recommendPrice(strategy : StrategyType, params : PricingParameters, manualBaseline : Money) : PriceRecommendation
    + acceptPrice(rec : PriceRecommendation, acceptedAiIds : List<UUID>) : PriceRecommendation
    + analyzePositioning() : PositioningReport
    + forecast(monthlyHoldingCost : Money) : DepreciationForecast
    + generateListing(options : ListingOptions) : GeneratedListing
    + editListing(edit : ListingEdit) : GeneratedListing
    + overrideListingValidation() : GeneratedListing
    + exportListing(platform : Platform, out : Path) : ExportedListing
    + startSimulation(persona : Persona) : SimulationSession
    + sendSellerMessage(text : String) : ChatTurn
    + endSimulation() : CoachingReport
    + evaluateOffer(offer : Offer) : OfferEvaluation
    + runGoal(goal : String, autoApprove : boolean) : Plan
    + answerCheckpoint(decision : CheckpointDecision) : Plan
    + resumeRun() : Plan
    + cancelRun() : Plan
    + currentPlan() : Optional<Plan>
    + lastNotes() : List<String>
    + sessions() : SessionService
    + events() : EventBus
    + trace() : AgentTrace
  }

  class "AgentController.PlanSteps" as PlanSteps

  interface StepRunner {
    + run(plan : Plan, step : PlanStep) : String
    + approved(plan : Plan, step : PlanStep) : void
    + finish(plan : Plan) : SalesPackage
  }

  class SessionService {
    + current() : Session
    + hasCurrent() : boolean
    + create(profile : VehicleProfile) : Session
    + findMatching(profile : VehicleProfile) : Optional<SessionSummary>
    + saveCurrent() : void
    + list() : List<SessionSummary>
    + open(id : UUID) : Session
    + rename(id : UUID, name : String) : void
    + duplicate(id : UUID) : Session
    + delete(id : UUID) : void
    + compare(a : UUID, b : UUID) : SnapshotComparison
    + backup(folder : Path) : Path
    + hasUnsavedChanges() : boolean
  }

  class PlanExecutor <<Context>> {
    - plan : Plan
    - state : PlanRunState
    + execute(plan : Plan, sessionId : UUID) : void
    + approve(decision : CheckpointDecision) : void
    + resume() : void
    + cancel() : void
    + plan() : Optional<Plan>
    + notice() : String
    ~ restore(plan : Plan, sessionId : UUID) : void
    ~ changeState(next : PlanRunState) : void
    ~ runNextStep() : StepResult
    ~ awaitApproval(step : PlanStep) : void
    ~ applyApproval(step : PlanStep) : void
    ~ complete() : void
    ~ stop() : void
  }

  interface PlanRunState <<State>> {
    + advance(ctx : PlanExecutor) : void
    + approve(ctx : PlanExecutor, decision : CheckpointDecision) : void
    + resume(ctx : PlanExecutor) : void
    + cancel(ctx : PlanExecutor) : void
    + status() : PlanStatus
    + {static} of(status : PlanStatus) : PlanRunState
  }
  class RunningState
  class AwaitingApprovalState
  class PausedState
  class CompletedState
  class CancelledState

  class EventBus {
    - listeners : Map<Class, List<EventListener>>
    + subscribe(type : Class, l : EventListener) : void
    + unsubscribe(type : Class, l : EventListener) : void
    + publish(event : AgentEvent) : void
  }

  interface EventListener {
    + onEvent(event : AgentEvent) : void
  }

  class AutoSaveListener {
    + onEvent(event : AgentEvent) : void
  }

  abstract class AgentEvent {
    - occurredAt : Instant
    - sessionId : UUID
  }
  class ProfileUpdated
  class HistoryUpdated
  class MarketDataReady
  class PriceRecommended
  class ListingGenerated
  class SessionUpdated {
    - part : String
  }
  class StepProgress {
    - step : PlanStep
  }
  class CheckpointReached {
    - step : PlanStep
  }
}

package "avsa.agent (see 3.6)" {
  class Planner <<ref>>
  class AiTaskRunner <<ref>>
  class ToolManager <<ref>>
  class AgentTrace <<ref>>
}

package "avsa.services (see 3.7)" {
  class BuyerSimulator <<ref>>
  class ListingValidator <<ref>>
}

package "avsa.infrastructure (see 3.8)" {
  class SessionRepository <<ref>>
}

MainWindow --> "1" GuiContext
GuiContext --> "1" AgentController
AvsaCli --> "1" AgentController
AvsaCli ..> CliOptions
MainWindow ..> CurrentSessionFile
AvsaCli ..> CurrentSessionFile
MainWindow *-- "12" FeatureTab
FeatureTab --> "1" GuiContext
FeatureTab <|-- VehicleTab
FeatureTab <|-- HistoryTab
FeatureTab <|-- MarketTab
FeatureTab <|-- PricingTab
FeatureTab <|-- PositioningTab
FeatureTab <|-- ForecastTab
FeatureTab <|-- ListingTab
FeatureTab <|-- ExportTab
FeatureTab <|-- OffersTab
FeatureTab <|-- SimulatorTab
FeatureTab <|-- SessionsTab
FeatureTab <|-- AssistantPanel
MainWindow ..|> EventListener
AvsaCli ..|> EventListener
AutoSaveListener ..|> EventListener
MainWindow ..> AvsaApplication : create()
AvsaCli ..> AvsaApplication : create()
AvsaApplication ..> AgentController : wires

AgentController *-- "1" EventBus
AgentController --> "1" SessionService
AgentController *-- "1" PlanExecutor
AgentController --> "1" Planner
AgentController --> "1" AiTaskRunner
AgentController --> "1" ToolManager
AgentController --> "1" AgentTrace
AgentController --> "1" ListingValidator
AgentController --> "1" BuyerSimulator : F09 chat
AgentController *-- PlanSteps
StepRunner <|.. PlanSteps
PlanSteps ..> AgentController : calls its own\nfeature methods

PlanExecutor --> "1" StepRunner
PlanExecutor o-- "1" PlanRunState : current
PlanRunState <|.. RunningState
PlanRunState <|.. AwaitingApprovalState
PlanRunState <|.. PausedState
PlanRunState <|.. CompletedState
PlanRunState <|.. CancelledState
PlanExecutor --> "1" EventBus : progress,\ncheckpoints

SessionService --> "1" SessionRepository
AutoSaveListener --> "1" SessionService : saveCurrent()

EventBus o-- "0..*" EventListener : notifies >
EventBus ..> AgentEvent : publishes
AgentEvent <|-- ProfileUpdated
AgentEvent <|-- HistoryUpdated
AgentEvent <|-- MarketDataReady
AgentEvent <|-- PriceRecommended
AgentEvent <|-- ListingGenerated
AgentEvent <|-- SessionUpdated
AgentEvent <|-- StepProgress
AgentEvent <|-- CheckpointReached

note right of AgentController
  Single entry point for both front ends.
  The GUI tabs and the CLI commands call
  only these methods.
end note

note bottom of GuiContext
  Runs every action on one worker thread
  behind a busy overlay (with Stop for long
  runs); results return on the JavaFX thread.
end note

note bottom of PlanRunState
  Running -> AwaitingApproval at a checkpoint;
  approve -> Running, reject -> Paused;
  resume -> Running; last step -> Completed;
  cancel from any non-final state -> Cancelled.
  Actions a state does not allow are ignored
  with a notice.
end note
@enduml
