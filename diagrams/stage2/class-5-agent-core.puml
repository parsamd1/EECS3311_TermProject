@startuml class-5-agent-core
!include style.iuml
left to right direction
title 3.6 Agent core (as implemented)

package "avsa.application (see 3.5)" {
  class AgentController <<ref>>
}

package "avsa.tools / avsa.services / avsa.infrastructure (see 3.7, 3.8)" {
  class "Tools (F02, F03, F05, F07, F11)" as ToolsRef <<ref>>
  class BuyerSimulator <<ref>>
  class LiveSearchSource <<ref>>
}

package "avsa.agent.tasks" {
  class ListingSearchTask
  class CompReviewTask
  class PriceExplanationTask
  class PositioningTask
  class ListingDraftTask
  class CounterScriptTask
  class PlanProposalTask
  class BuyerTurnTask
  class CoachingTask
  class ConnectionCheckTask
}

package "avsa.agent" {

  class Planner {
    + propose(goal : String, profile : VehicleProfile, autoApprove : boolean) : Plan
    + lastNotes() : List<String>
  }

  class PlanValidator {
    + validate(plan : Plan) : Plan
  }

  class StepCatalog {
    + isRegistered(type : StepType) : boolean
    + lookup(name : String) : Optional<StepType>
    + prerequisitesOf(type : StepType) : List<StepType>
    + isCheckpoint(type : StepType) : boolean
    + templatePlanFor(goal : String) : PlanProposal
  }

  class AiTaskRunner {
    + <T> run(task : AiTask<T>) : AiResult<T>
    + composer() : PromptComposer
  }

  interface "AiTask<T>" as AiTask {
    + name() : String
    + buildPrompt(composer : PromptComposer) : LLMRequest
    + resultType() : Class<T>
    + validate(result : T) : List<String>
    + fallback() : T
    + maxAttempts() : int
  }

  class "AiResult<T>" as AiResult {
    - value : T
    - usedFallback : boolean
    - notes : List<String>
    - sources : Set<String>
  }

  class PromptComposer {
    + listingSearch(query : MarketQuery) : LLMRequest
    + compReview(listings : List<ComparableListing>, trim : String) : LLMRequest
    + pricingExplanation(rec : PriceRecommendation, facts : VehicleFacts, comparableCount : int) : LLMRequest
    + positioning(metrics : List<PercentileMetric>, top : List<ComparableListing>, facts : VehicleFacts, price : PriceRecommendation) : LLMRequest
    + listing(facts : VehicleFacts, options : ListingOptions) : LLMRequest
    + persona(p : Persona, facts : VehicleFacts, listingText : String, turns : List<ChatMessage>, asking : Money, opening : Money, ceiling : Money) : LLMRequest
    + coaching(p : Persona, facts : VehicleFacts, transcript : List<ChatTurn>) : LLMRequest
    + counterScript(evaluation : OfferEvaluation, price : PriceRecommendation, comps : List<ComparableListing>) : LLMRequest
    + planProposal(goal : String, vehicle : String, catalog : StepCatalog) : LLMRequest
    + connectionCheck() : LLMRequest
    + repair(request : LLMRequest, errors : List<String>) : LLMRequest
  }

  class ResponseParser {
    + <T> parse(response : LLMResponse, type : Class<T>) : ParseResult<T>
  }

  class LLMRequest {
    - purpose : String
    - system : String
    - user : String
    - maxTokens : long
    - webSearch : WebSearchOptions [0..1]
  }
  class LLMResponse {
    - text : String
    - sourceUrls : Set<String>
    - inputTokens : long
    - outputTokens : long
    - webSearches : long
    - stopReason : String
  }

  interface LLMClient {
    + complete(request : LLMRequest) : LLMResponse
  }
  class ClaudeClient {
    - modelId : String
  }
  class MockLLMClient {
    - scripted : Queue<LLMResponse>
    - failureMode : FailureMode
  }

  class ToolManager <<Invoker>> {
    - registry : Map<String, Tool>
    + register(tool : Tool) : void
    + execute(name : String, args : ToolArgs) : ToolResult
  }

  interface Tool <<Command>> {
    + name() : String
    + execute(args : ToolArgs) : ToolResult
  }

  class MemoryManager {
    - maxContextTurns : int
    + append(conversationId : UUID, turn : ChatMessage) : void
    + window(conversationId : UUID) : List<ChatMessage>
  }

  class ConversationMemory {
    - turns : List<ChatMessage>
    - summary : String
  }

  class AgentTrace {
    + recordPrompt(request : LLMRequest) : void
    + recordResponse(task : String, response : LLMResponse) : void
    + recordRejected(task : String, errors : List<String>) : void
    + recordFallback(task : String) : void
    + recordToolCall(name : String, args : ToolArgs, result : ToolResult) : void
    + toJson(mapper : JsonMapper) : String
  }

  class TraceEntry {
    - timestamp : Instant
    - kind : TraceKind
    - name : String
    - payload : String
    - error : String [0..1]
  }

AgentController --> Planner
AgentController --> AiTaskRunner : connection check
AgentController --> ToolManager
ToolsRef --> AiTaskRunner
BuyerSimulator --> AiTaskRunner
BuyerSimulator --> MemoryManager
LiveSearchSource --> AiTaskRunner : ListingSearchTask

Planner --> "1" AiTaskRunner
Planner --> "1" PlanValidator
Planner --> "1" StepCatalog
PlanValidator --> "1" StepCatalog

AiTaskRunner --> "1" PromptComposer
AiTaskRunner --> "1" LLMClient
AiTaskRunner --> "1" ResponseParser
AiTaskRunner --> "1" AgentTrace
AiTaskRunner ..> AiTask : runs
AiTask <|.. ListingSearchTask
AiTask <|.. CompReviewTask
AiTask <|.. PriceExplanationTask
AiTask <|.. PositioningTask
AiTask <|.. ListingDraftTask
AiTask <|.. CounterScriptTask
AiTask <|.. PlanProposalTask
AiTask <|.. BuyerTurnTask
AiTask <|.. CoachingTask
AiTask <|.. ConnectionCheckTask
AiTaskRunner ..> AiResult : returns
LLMClient <|.. ClaudeClient
LLMClient <|.. MockLLMClient
LLMClient ..> LLMRequest
LLMClient ..> LLMResponse

ToolManager o-- "0..*" Tool
ToolManager --> "1" AgentTrace
MemoryManager *-- "0..*" ConversationMemory
AgentTrace *-- "0..*" TraceEntry

note right of AiTaskRunner
  Standard AI failure handling (§2.2):
  call, parse, validate. On a timeout or
  malformed or invalid output, ask again
  with the errors (repair), up to
  maxAttempts; then task.fallback().
  usedFallback is labelled in the GUI/CLI.
end note

note bottom of PlanValidator
  Adds missing prerequisites, drops an
  export with no platform, orders steps,
  sets checkpoints, caps the step count.
end note

note bottom of PromptComposer
  The only class that builds prompts.
  Takes VehicleFacts (no VIN, no contact
  details), so nothing private is sent.
end note

note bottom of ClaudeClient
  Anthropic Java SDK, claude-haiku-5-5;
  web search + fetch only for
  ListingSearchTask (live search).
end note
}
@enduml
